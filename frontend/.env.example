# =================================================================
# PLAYBEAT DIGITAL - FRONTEND ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to .env.local for local development
# Set these in Vercel Dashboard → Project Settings → Environment Variables

# -----------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------
# Production: Point to your deployed backend API
VITE_API_URL=https://api.playbeat.digital/api

# Staging/Preview
# VITE_API_URL=https://api-staging.playbeat.digital/api

# Local Development
# VITE_API_URL=http://localhost:5000/api

# -----------------------------------------------------------------
# STRIPE PAYMENT CONFIGURATION
# -----------------------------------------------------------------
# Get from Stripe Dashboard → Developers → API Keys
# Production
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Test/Development
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key_here

# -----------------------------------------------------------------
# SITE CONFIGURATION
# -----------------------------------------------------------------
VITE_SITE_URL=https://playbeat.digital
VITE_SITE_NAME=PlayBeat Digital

# -----------------------------------------------------------------
# ANALYTICS (Optional)
# -----------------------------------------------------------------
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_FACEBOOK_PIXEL_ID=xxxxxxxxxx
