# =================================================================
# PLAYBEAT DIGITAL - ROOT ENVIRONMENT VARIABLES (TEMPLATE)
# =================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit real credentials to git.

# =================================================================
# DATABASE
# =================================================================

# PostgreSQL / Neon (RECOMMENDED — used by backend/src/config/postgres.js)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# MongoDB (Alternative — used by backend/src/config/database.js)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/playbeat?retryWrites=true&w=majority

# =================================================================
# AUTH
# =================================================================
JWT_SECRET=replace-with-64-random-hex-chars
JWT_REFRESH_SECRET=replace-with-different-64-random-hex-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# =================================================================
# SERVER
# =================================================================
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# =================================================================
# ADMIN
# =================================================================
ADMIN_EMAIL=admin@playbeat.digital
ADMIN_PASSWORD=ChangeMe123!

# =================================================================
# PAYMENTS
# =================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key

# =================================================================
# EMAIL
# =================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@playbeat.digital

# =================================================================
# RATE LIMITING
# =================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =================================================================
# FRONTEND (Vite reads VITE_* vars at build time)
# =================================================================
VITE_API_URL=http://localhost:5000/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key
VITE_SITE_URL=http://localhost:5173
