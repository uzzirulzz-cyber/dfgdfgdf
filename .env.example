# =================================================================
# PLAYBEAT DIGITAL - ROOT ENVIRONMENT VARIABLES
# =================================================================
# This file is used when running both frontend and backend locally
# via `npm run dev` from the root directory

# =================================================================
# DATABASE
# =================================================================

# PostgreSQL / Neon (RECOMMENDED)
DATABASE_URL=postgresql://neondb_owner:npg_1vb3ErDaYXSs@ep-noisy-grass-aytj322a-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# MongoDB (Alternative)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/playbeat?retryWrites=true&w=majority

# =================================================================
# AUTH
# =================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-different-refresh-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# =================================================================
# SERVER
# =================================================================
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# =================================================================
# ADMIN
# =================================================================
ADMIN_EMAIL=admin@playbeat.digital
ADMIN_PASSWORD=ChangeMe123!

# =================================================================
# PAYMENTS
# =================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key

# =================================================================
# EMAIL
# =================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@playbeat.digital

# =================================================================
# RATE LIMITING
# =================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =================================================================
# FRONTEND (for local dev, Vite proxy uses these)
# =================================================================
VITE_API_URL=http://localhost:5000/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key
VITE_SITE_URL=http://localhost:5173
