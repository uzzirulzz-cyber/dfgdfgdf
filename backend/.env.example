# =================================================================
# PLAYBEAT DIGITAL - BACKEND ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to .env for local development
# Set these in Vercel Dashboard → Project Settings → Environment Variables

# =================================================================
# DATABASE CONFIGURATION (Choose ONE)
# =================================================================

# Option A: PostgreSQL / Neon (RECOMMENDED for Vercel)
# Get from Neon Console → Connection Details
DATABASE_URL=postgresql://neondb_owner:npg_1vb3ErDaYXSs@ep-noisy-grass-aytj322a-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: MongoDB Atlas (Original)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/playbeat?retryWrites=true&w=majority

# =================================================================
# AUTHENTICATION & SECURITY
# =================================================================

# JWT Secret - Generate a strong random string (64+ chars)
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-64-characters-long

# JWT Refresh Secret - DIFFERENT from JWT_SECRET
JWT_REFRESH_SECRET=your-different-refresh-secret-key-change-this-minimum-64-characters

# Token Expiration
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Password Hashing Rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# =================================================================
# SERVER CONFIGURATION
# =================================================================

NODE_ENV=production
PORT=5000

# Your deployed frontend URL (for CORS)
FRONTEND_URL=https://playbeat.digital

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGIN=https://playbeat.digital

# =================================================================
# ADMIN SEED CREDENTIALS
# =================================================================

# These are used to create the first super admin account
# CHANGE THE PASSWORD AFTER FIRST LOGIN!
ADMIN_EMAIL=admin@playbeat.digital
ADMIN_PASSWORD=ChangeMe123!SecurePassword

# =================================================================
# PAYMENT PROVIDERS
# =================================================================

# Stripe (Recommended for digital products)
# Get from Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# PayPal (Optional)
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Lemon Squeezy (Optional)
# LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key
# LEMON_SQUEEZY_STORE_ID=your_store_id

# =================================================================
# EMAIL CONFIGURATION (Required for order confirmations, password reset)
# =================================================================

# SMTP Settings (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-api-key
EMAIL_FROM=noreply@playbeat.digital
EMAIL_FROM_NAME=PlayBeat Digital

# =================================================================
# CLOUD STORAGE (Optional - for product images)
# =================================================================

# Cloudinary
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (Alternative)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1

# =================================================================
# REDIS / CACHE (Optional - for sessions, rate limiting)
# =================================================================

# REDIS_URL=redis://username:password@host:port

# =================================================================
# RATE LIMITING
# =================================================================

# Window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window per IP
RATE_LIMIT_MAX=100

# =================================================================
# LOGGING
# =================================================================

# Log level: error, warn, info, debug
LOG_LEVEL=info
